            where TOut : unmanaged
        {
            fixed (TIn* inputPtr = &input)
            fixed (TOut* outputPtr = &output)
            {
                return DirectInputEscape(
                    command,
                    inputPtr, (uint32_t)sizeof(TIn),
                    outputPtr, (uint32_t)sizeof(TOut),
                    out bytesReturned
                );
            }
        }
