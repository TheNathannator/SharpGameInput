<#@ template hostspecific="false" language="C#" #>
<#@ output extension=".cs" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#
UsingDirectives.Add("System");

FnPointerTypeReplacements.Add("GameInputCallbackToken", "ulong");
FnPointerTypeReplacements.Add("LightGameInputCallbackToken", "ulong");

Callbacks = [
    new()
    {
        ShortName = "ReadingCallback",
        Delegate = new("void", "GameInputReadingCallback", [
            ("LightGameInputCallbackToken", "callbackToken"),
            ("object?", "context"),
            ("owned LightIGameInputReading", "reading"),
            ("bool", "hasOverrunOccurred"),
        ]),
        RegisterParameters = [
            ("IGameInputDevice?", "device"),
            ("GameInputKind", "inputKind"),
            ("float", "analogThreshold"),
        ]
    },
    new()
    {
        ShortName = "DeviceCallback",
        Delegate = new("void", "GameInputDeviceCallback", [
            ("LightGameInputCallbackToken", "callbackToken"),
            ("object?", "context"),
            ("LightIGameInputDevice", "device"),
            ("uint64_t", "timestamp"),
            ("GameInputDeviceStatus", "currentStatus"),
            ("GameInputDeviceStatus", "previousStatus"),
        ]),
        RegisterParameters = [
            ("IGameInputDevice?", "device"),
            ("GameInputKind", "inputKind"),
            ("GameInputDeviceStatus", "statusFilter"),
            ("GameInputEnumerationKind", "enumerationKind"),
        ]
    },
    // gg Microsoft, ABI breakage
    // new()
    // {
    //     ShortName = "GuideButtonCallback",
    //     Delegate = new("void", "GameInputGuideButtonCallback", [
    //         ("LightGameInputCallbackToken", "callbackToken"),
    //         ("object?", "context"),
    //         ("LightIGameInputDevice", "device"),
    //         ("uint64_t", "timestamp"),
    //         ("bool", "isPressed"),
    //     ]),
    //     RegisterParameters = []
    // },
    new()
    {
        ShortName = "SystemButtonCallback",
        Delegate = new("void", "GameInputSystemButtonCallback", [
            ("LightGameInputCallbackToken", "callbackToken"),
            ("object?", "context"),
            ("LightIGameInputDevice", "device"),
            ("uint64_t", "timestamp"),
            ("GameInputSystemButtons", "currentState"),
            ("GameInputSystemButtons", "previousState"),
        ]),
        RegisterParameters = [
            ("IGameInputDevice?", "device"),
            ("GameInputSystemButtons", "buttonFilter"),
        ]
    },
    new()
    {
        ShortName = "KeyboardLayoutCallback",
        Delegate = new("void", "GameInputKeyboardLayoutCallback", [
            ("LightGameInputCallbackToken", "callbackToken"),
            ("object?", "context"),
            ("LightIGameInputDevice", "device"),
            ("uint64_t", "timestamp"),
            ("uint32_t", "currentLayout"),
            ("uint32_t", "previousLayout"),
        ]),
        RegisterParameters = [
            ("IGameInputDevice?", "device"),
        ]
    },
];
#>