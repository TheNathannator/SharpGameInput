void MakeArrayWrappers(string returnType, string name, params ParameterDecl[] parameters)
{
    // MethodDecl is used here to perform type name replacement like everything else does
    var decl = new MethodDecl(returnType, name, parameters);
    var array = decl.Parameters[0];
#>

        public <#= decl.ReturnType.ToTypeDecl() #> <#= decl.Name #>(<#= array.Type.Name #>[] <#= array.Name #>)
        {
            fixed (<#= array.Type.Name #>* ptr = <#= array.Name #>)
            {
                return <#= decl.Name #>((uint)<#= array.Name #>.Length, ptr);
            }
        }

#if NETSTANDARD2_1_OR_GREATER
        public <#= decl.ReturnType.ToTypeDecl() #> <#= decl.Name #>(scoped System.Span<<#= array.Type.Name #>> <#= array.Name #>)
        {
            fixed (<#= array.Type.Name #>* ptr = <#= array.Name #>)
            {
                return <#= decl.Name #>((uint)<#= array.Name #>.Length, ptr);
            }
        }
#endif
<#
}
#>