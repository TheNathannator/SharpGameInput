        new(() =>
        {
#>

        public HRESULT DirectInputEscape<TIn>(
            uint32_t command,
            in TIn input
        )
            where TIn : unmanaged
        {
            fixed (TIn* inputPtr = &input)
            {
                return DirectInputEscape(
                    command,
                    inputPtr, (uint32_t)sizeof(TIn),
                    null, 0,
                    out _
                );
            }
        }

        public HRESULT DirectInputEscape<TOut>(
            uint32_t command,
            out TOut output,
            out uint32_t bytesReturned
        )
            where TOut : unmanaged
        {
            fixed (TOut* outputPtr = &output)
            {
                return DirectInputEscape(
                    command,
                    null, 0,
                    outputPtr, (uint32_t)sizeof(TOut),
                    out bytesReturned
                );
            }
        }

        public HRESULT DirectInputEscape<TIn, TOut>(
            uint32_t command,
            in TIn input,
            out TOut output,
            out uint32_t bytesReturned
        )
            where TIn : unmanaged
            where TOut : unmanaged
        {
            fixed (TIn* inputPtr = &input)
            fixed (TOut* outputPtr = &output)
            {
                return DirectInputEscape(
                    command,
                    inputPtr, (uint32_t)sizeof(TIn),
                    outputPtr, (uint32_t)sizeof(TOut),
                    out bytesReturned
                );
            }
        }
<#
