<#@ template hostspecific="false" language="C#" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#@ output extension=".cs" #>
<#+
// Types that are identified as interfaces.
public static HashSet<string> InterfaceTypes = new();
public static HashSet<string> LightInterfaceTypes = new();

// Type declarations to be entirely replaced before parsing them.
// Replacements are performed recursively, so one replacement can alias directly to another.
public static Dictionary<string, string> DeclarationReplacements = new()
{
    { "REFIID", "ref Guid" },
    { "IUnknown*", "IntPtr" },
};

// Type names to be substituted for proper C# equivalents.
// Replacements are performed recursively, so one replacement can alias directly to another.
public static Dictionary<string, string> TypeNameReplacements = new()
{
    { "int8_t", "sbyte" },
    { "uint8_t", "byte" },
    { "int16_t", "short" },
    { "uint16_t", "ushort" },
    { "int32_t", "int" },
    { "uint32_t", "uint" },
    { "int64_t", "long" },
    { "uint64_t", "ulong" },
    { "size_t", "nuint" },
    { "ssize_t", "nint" },

    { "char_t", "byte" },
    { "wchar_t", "char" },

    { "ULONG", "uint" },

    { "IID", "Guid" },
    { "HRESULT", "int" },
    { "HANDLE", "IntPtr" },
};

public enum Visibility
{
    Public,
    Internal,
    Private,
}

public enum ParameterIndirection
{
    None,
    In,
    Out,
    Ref,
    RefReadonly,
}

[Flags]
public enum ParameterFlag
{
    None = 0,

    Nullable = 0x01,
    Pointer  = 0x02,

    Interface = 0x10,
    LightInterface = 0x20,
}

public struct InterfaceParameter
{
    public string Name;
    public string TypeName;

    public ParameterIndirection Indirection;
    public ParameterFlag Flags;

    public InterfaceParameter(string typeDecl, string name)
    {
        // Swap out full declarations for their underlying declarations
        while (DeclarationReplacements.TryGetValue(typeDecl, out string declReplacement))
        {
            typeDecl = declReplacement;
        }

        string typeName = typeDecl;
        var flags = ParameterFlag.None;
        var indirection = ParameterIndirection.None;

        // Pseudo-syntax for allowing nullable pointer types;
        // not actually supported in C#
        if (typeDecl.EndsWith("*?"))
        {
            typeDecl = typeDecl[..^1];
        }

        // Value indirection
        if (typeName.StartsWith("in "))
        {
            indirection = ParameterIndirection.In;
            typeName = typeName["in ".Length..];
        }
        else if (typeName.StartsWith("out "))
        {
            indirection = ParameterIndirection.Out;
            typeName = typeName["out ".Length..];
        }
        else if (typeName.StartsWith("ref readonly "))
        {
            indirection = ParameterIndirection.RefReadonly;
            typeName = typeName["ref readonly ".Length..];
        }
        else if (typeName.StartsWith("ref "))
        {
            indirection = ParameterIndirection.Ref;
            typeName = typeName["ref ".Length..];
        }

        // Other modifiers
        if (typeName.EndsWith("?"))
        {
            flags |= ParameterFlag.Nullable;
            typeName = typeName[..^1];
        }
        if (typeName.EndsWith("*"))
        {
            flags |= ParameterFlag.Pointer;
            typeName = typeName[..^1];
        }

        if (typeDecl.StartsWith("fn("))
        {
            // Pseudo-syntax for function pointer types
            // fn(int, void*, Foo) -> void

            int closeIndex = typeDecl.IndexOf(") -> ");
            if (closeIndex < 0)
            {
                throw new Exception($"Function type '{typeDecl}' is missing its parameter list closing delimiter");
            }

            string parameterList = typeDecl[3..closeIndex];
            string returnType = typeDecl[(closeIndex + 5)..];

            string[] parameters = parameterList.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select((p) => new InterfaceParameter(p, "").ToFnPointerType())
                .ToArray();

            if (parameters.Length > 0)
            {
                typeName = $"delegate* unmanaged[Stdcall]<{string.Join(", ", parameters)}, {returnType}>";
            }
            else
            {
                typeName = $"delegate* unmanaged[Stdcall]<{returnType}>";
            }
        }
        else
        {
            // Regular types

            // Convert type names where needed
            while (TypeNameReplacements.TryGetValue(typeName, out string nameReplacement))
            {
                typeName = nameReplacement;
            }

            if (InterfaceTypes.Contains(typeName))
            {
                flags |= ParameterFlag.Interface;
                flags &= ~ParameterFlag.Pointer; // Interface pointers are wrapped

                if (LightInterfaceTypes.Contains(typeName))
                {
                    flags |= ParameterFlag.LightInterface;
                }
            }
        }

        Name = name;
        TypeName = typeName;

        Indirection = indirection;
        Flags = flags;
    }

    private static string ToModifierPrefix(ParameterIndirection indirection) => indirection switch
    {
        ParameterIndirection.In => "in ",
        ParameterIndirection.Out => "out ",
        ParameterIndirection.Ref => "ref ",
        ParameterIndirection.RefReadonly => "ref readonly ",
        _ => "",
    };

    public string ToTypeDecl()
    {
        string typeDecl = TypeName;

        // Re-apply type modifiers
        if ((Flags & ParameterFlag.Pointer) != 0)
        {
            typeDecl += "*";
        }
        // Note that pointers cannot be nullable; the `else` is important here
        else if ((Flags & ParameterFlag.Nullable) != 0)
        {
            typeDecl += "?";
        }

        typeDecl = $"{ToModifierPrefix(Indirection)}{typeDecl}";

        return typeDecl;
    }

    public string ToFnPointerType()
    {
        string type = TypeName;

        if ((Flags & ParameterFlag.Interface) != 0)
        {
            // Interfaces must be marshalled as their pointer values
            type = "IntPtr";
        }

        type = ToModifierPrefix(Indirection) + type;

        // Re-apply pointer modifier
        if ((Flags & ParameterFlag.Pointer) != 0)
        {
            type += '*';
        }

        return type;
    }

    public string ToFnPointerArgument()
    {
        string argument = Name;

        if ((Flags & ParameterFlag.Interface) != 0)
        {
            // Handle interface marshalling
            if (Indirection == ParameterIndirection.Out)
            {
                // Interface handle being returned
                // Combines with modifier prefix to create `out IntPtr name_handle`
                argument = $"IntPtr {Name}_handle";
            }
            else if ((Flags & ParameterFlag.Nullable) != 0)
            {
                // Optional interface instance
                argument = $"{Name}?.DangerousGetHandle() ?? IntPtr.Zero";
            }
            else
            {
                // Required interface instance
                argument = $"{Name}.DangerousGetHandle()";
            }
        }

        argument = ToModifierPrefix(Indirection) + argument;

        return argument;
    }

    public static implicit operator InterfaceParameter((string TypeDecl, string Name) parameter)
        => new(parameter.TypeDecl, parameter.Name);
}

public struct InterfaceMethod
{
    public string Name;
    public Visibility Visibility;
    public InterfaceParameter ReturnType;
    public InterfaceParameter[] Parameters;

    public bool IsCustom;
    public Action CustomAction;

    public string VisModifier => Visibility switch
    {
        Visibility.Public => "public",
        Visibility.Internal => "internal",
        Visibility.Private => "private",
        _ => throw new System.Diagnostics.UnreachableException($"Invalid visibility {Visibility}")
    };

    public bool IsVoid => ReturnType.TypeName == "void";

    public InterfaceMethod(string returnType, string name, params InterfaceParameter[] parameters)
        : this(Visibility.Public, returnType, name, parameters)
    {
    }

    public InterfaceMethod(Visibility visibility, string returnType, string name, params InterfaceParameter[] parameters)
    {
        Name = name;
        Visibility = visibility;
        ReturnType = new(returnType, "<return>");
        Parameters = parameters;

        IsCustom = false;
        CustomAction = null;
    }

    public InterfaceMethod(Action customAction)
    {
        Name = "";
        Visibility = Visibility.Public;
        ReturnType = new("", "<return>");
        Parameters = Array.Empty<InterfaceParameter>();

        IsCustom = true;
        CustomAction = customAction;
    }
}

public void DefineInterface(string name, params InterfaceMethod[] methods)
{
#>
    public sealed unsafe partial class <#= name #> : GameInputComPtr<<#= name #>>
    {
        internal <#= name #>(IntPtr handle, bool ownsHandle) : base(handle, ownsHandle) { }

        protected override <#= name #> DuplicateImpl() => new(handle, true);
<#+ ForwardInterfaceMethods(methods); #>
    }
<#+
}

public void DefineLightInterface(string name, params InterfaceMethod[] methods)
{
#>
    public sealed unsafe partial class <#= name #> : GameInputComPtr<<#= name #>>
    {
        internal <#= name #>(IntPtr handle, bool ownsHandle) : base(handle, ownsHandle) { }

        protected override <#= name #> DuplicateImpl() => new(handle, true);
<#+ ForwardInterfaceMethods(methods); #>

        public bool Equals(Light<#= name #> obj)
            => obj == this;
    }

    public unsafe ref partial struct Light<#= name #>
    {
        internal IntPtr handle;
        private bool ownsHandle;

        public bool IsInvalid => handle == IntPtr.Zero;

        internal Light<#= name #>(IntPtr handle, bool ownsHandle)
        {
            this.handle = handle;
            this.ownsHandle = ownsHandle;
        }

        public void Dispose()
        {
            if (handle != IntPtr.Zero && ownsHandle)
            {
                Marshal.Release(handle);
                handle = IntPtr.Zero;
            }
        }

        public IntPtr DangerousGetHandle() => handle;

        public <#= name #> ToComPtr()
        {
            // Move handle to the new instance
            var handle = this.handle;
            this.handle = IntPtr.Zero;
            return new(handle, ownsHandle);
        }

        public static implicit operator Light<#= name #>(<#= name #> instance)
        {
            return new(instance.DangerousGetHandle(), ownsHandle: false);
        }

        public static bool operator ==(Light<#= name #> left, Light<#= name #> right)
        {
            // GameInput interfaces can be compared directly by pointer for equality
            return left.handle == right.handle;
        }

        public static bool operator ==(<#= name #>? left, Light<#= name #> right)
        {
            return left?.handle == right.handle;
        }

        public static bool operator ==(Light<#= name #> left, <#= name #>? right)
        {
            return left.handle == right?.handle;
        }

        public static bool operator !=(Light<#= name #> left, Light<#= name #> right)
            => !(left == right);

        public static bool operator !=(<#= name #>? left, Light<#= name #> right)
            => !(left == right);

        public static bool operator !=(Light<#= name #> left, <#= name #>? right)
            => !(left == right);

        public bool Equals(Light<#= name #> obj)
            => obj == this;

        public bool Equals(<#= name #> obj)
            => obj == this;

#pragma warning disable CS0809 // Obsolete member overrides non-obsolete member
        [Obsolete("Equals(object) on Light<#= name #> will always throw an exception. Use the equality operator instead.", true)]
        public override bool Equals(object? obj)
            => throw new NotSupportedException();
#pragma warning restore CS0809

        public override int GetHashCode()
            => handle.GetHashCode();
<#+ ForwardInterfaceMethods(methods); #>
    }
<#+
}

private void ForwardInterfaceMethods(InterfaceMethod[] methods)
{
    int vtableIndex = 0;

    // IUnknown methods
    // These are already provided through the Marshal class,
    // so we don't need to expose them ourselves
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "HRESULT", "QueryInterface", 
    //     ("REFIID", "riid"),
    //     ("out void*", "ppvObj")
    // ));
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "ULONG", "AddRef"));
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "ULONG", "Release"));
    vtableIndex += 3;

    // Other interface methods
    for (int i = 0; i < methods.Length; i++)
    {
        var method = methods[i];
        if (method.IsCustom)
        {
            method.CustomAction();
        }
        else
        {
            ForwardMethod(vtableIndex++, methods[i]);
        }
    }
}

private void ForwardMethod(int vtableIndex, InterfaceMethod method)
{
    var fnPtrTypes = method.Parameters.Select((p) => p.ToFnPointerType()).Prepend("IntPtr").Append(method.ReturnType.ToTypeDecl());
    var fnCallArgs = method.Parameters.Select((p) => p.ToFnPointerArgument()).Prepend("thisPtr");
    string fnPtrType = $"delegate* unmanaged[Stdcall]<{string.Join(", ", fnPtrTypes)}>";

    // Make the generated code look a little nicer if there's no parameters
    if (method.Parameters.Length < 1)
    {
#>

        <#= method.VisModifier #> <#= method.ReturnType.ToTypeDecl() #> <#= method.Name #>()
<#+
    }
    else
    {
#>

        <#= method.VisModifier #> <#= method.ReturnType.ToTypeDecl() #> <#= method.Name #>(
<#+
        for (int i = 0; i < method.Parameters.Length; i++)
        {
            var parameter = method.Parameters[i];
            // Can't use a comma on the last argument
            if (i < method.Parameters.Length - 1)
            {
#>
            <#= parameter.ToTypeDecl() #> <#= parameter.Name #>,
<#+
            }
            else
            {
#>
            <#= parameter.ToTypeDecl() #> <#= parameter.Name #>
<#+
            }
        }
#>
        )
<#+
    }
#>
        {
            ThrowHelper.CheckDisposed(IsInvalid, "this");
<#+
    foreach (var parameter in method.Parameters)
    {
        // Don't check output or optional parameters
        if (parameter.Indirection == ParameterIndirection.Out || (parameter.Flags & ParameterFlag.Nullable) != 0)
            continue;

        // Verify input handle types
        if ((parameter.Flags & ParameterFlag.LightInterface) != 0)
        {
#>
            ThrowHelper.CheckDisposed(<#= parameter.Name #>.IsInvalid, nameof(<#= parameter.Name #>));
<#+
        }
        else if ((parameter.Flags & ParameterFlag.Interface) != 0)
        {
#>
            ThrowHelper.CheckHandle(<#= parameter.Name #>);
<#+
        }
        // Verify pointer types
        else if ((parameter.Flags & ParameterFlag.Pointer) != 0)
        {
#>
            ThrowHelper.CheckNull(<#= parameter.Name #>);
<#+
        }
    }
#>

            var thisPtr = handle;
            var vtable = *(void***)thisPtr;
            var fnPtr = (<#= fnPtrType #>)vtable[<#= vtableIndex #>];

<#+
    if (method.IsVoid)
    {
#>
            fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#+
    }
    else
    {
        // Allow returning by indirection
        if (method.ReturnType.Indirection is ParameterIndirection.Ref)
        {
#>
            ref var result = ref fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#+
        }
        else if (method.ReturnType.Indirection is ParameterIndirection.RefReadonly)
        {
#>
            ref readonly var result = ref fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#+
        }
        else
        {
#>
            var result = fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#+
        }
    }

    foreach (var parameter in method.Parameters)
    {
        if ((parameter.Flags & ParameterFlag.Interface) != 0)
        {
            if (parameter.Indirection == ParameterIndirection.Out)
            {
#>
            <#= parameter.Name #> = new(<#= parameter.Name #>_handle, ownsHandle: true);
<#+
            }
        }
    }

    if (!method.IsVoid)
    {
        if (method.ReturnType.Indirection is ParameterIndirection.Ref or ParameterIndirection.RefReadonly)
        {
#>
            return ref result;
<#+
        }
        else
        {
#>
            return result;
<#+
        }
    }
#>
        }
<#+
}
#>