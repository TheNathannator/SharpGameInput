public string Namespace;
public HeaderNamespace[] AdditionalUsings;
public InterfaceDecl[] Interfaces;

// Types that are identified as interfaces.
public static HashSet<string> InterfaceTypes;
public static HashSet<string> LightInterfaceTypes;

// Type declarations to be entirely replaced before parsing them.
// Replacements are performed recursively, so one replacement can alias directly to another.
public static Dictionary<string, string> DeclarationReplacements = new()
{
    { "REFIID", "ref IID" },
    { "IUnknown*", "IntPtr" },
};

// Type names to be substituted for proper C# equivalents.
// Replacements are performed recursively, so one replacement can alias directly to another.
public static Dictionary<string, string> TypeNameReplacements = new()
{
    { "int8_t", "sbyte" },
    { "uint8_t", "byte" },
    { "int16_t", "short" },
    { "uint16_t", "ushort" },
    { "int32_t", "int" },
    { "uint32_t", "uint" },
    { "int64_t", "long" },
    { "uint64_t", "ulong" },
    { "size_t", "nuint" },
    { "ssize_t", "nint" },

    { "char_t", "byte" },
    { "wchar_t", "char" },

    { "ULONG", "uint" },

    { "IID", "Guid" },
    { "HRESULT", "int" },
    { "HANDLE", "IntPtr" },
};

public enum Visibility
{
    Public,
    Internal,
    Private,
}

public enum ParameterIndirection
{
    None,
    In,
    Out,
    Ref,
    RefReadonly,
}

[Flags]
public enum ParameterFlag
{
    None = 0,

    Nullable = 0x01,
    Pointer  = 0x02,

    Interface = 0x10,
    LightInterface = 0x20,
}

public struct InterfaceParameter
{
    public string Name;
    public string TypeName;

    public ParameterIndirection Indirection;
    public ParameterFlag Flags;

    public InterfaceParameter(string typeDecl, string name)
    {
        // Swap out full declarations for their underlying declarations
        while (DeclarationReplacements.TryGetValue(typeDecl, out string declReplacement))
        {
            typeDecl = declReplacement;
        }

        string typeName = typeDecl;
        var flags = ParameterFlag.None;
        var indirection = ParameterIndirection.None;

        // Pseudo-syntax for allowing nullable pointer types;
        // not actually supported in C#
        if (typeDecl.EndsWith("*?"))
        {
            typeDecl = typeDecl[..^1];
        }

        // Value indirection
        if (typeName.StartsWith("in "))
        {
            indirection = ParameterIndirection.In;
            typeName = typeName["in ".Length..];
        }
        else if (typeName.StartsWith("out "))
        {
            indirection = ParameterIndirection.Out;
            typeName = typeName["out ".Length..];
        }
        else if (typeName.StartsWith("ref readonly "))
        {
            indirection = ParameterIndirection.RefReadonly;
            typeName = typeName["ref readonly ".Length..];
        }
        else if (typeName.StartsWith("ref "))
        {
            indirection = ParameterIndirection.Ref;
            typeName = typeName["ref ".Length..];
        }

        // Other modifiers
        if (typeName.EndsWith("?"))
        {
            flags |= ParameterFlag.Nullable;
            typeName = typeName[..^1];
        }
        if (typeName.EndsWith("*"))
        {
            flags |= ParameterFlag.Pointer;
            typeName = typeName[..^1];
        }

        if (typeDecl.StartsWith("fn("))
        {
            // Pseudo-syntax for function pointer types
            // fn(int, void*, Foo) -> void

            int closeIndex = typeDecl.IndexOf(") -> ");
            if (closeIndex < 0)
            {
                throw new Exception($"Function type '{typeDecl}' is missing its parameter list closing delimiter");
            }

            string parameterList = typeDecl[3..closeIndex];
            string returnType = typeDecl[(closeIndex + 5)..];

            string[] parameters = parameterList.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select((p) => new InterfaceParameter(p, "").ToFnPointerType())
                .ToArray();

            if (parameters.Length > 0)
            {
                typeName = $"delegate* unmanaged[Stdcall]<{string.Join(", ", parameters)}, {returnType}>";
            }
            else
            {
                typeName = $"delegate* unmanaged[Stdcall]<{returnType}>";
            }
        }
        else
        {
            // Regular types

            // Convert type names where needed
            while (TypeNameReplacements.TryGetValue(typeName, out string nameReplacement))
            {
                typeName = nameReplacement;
            }

            if (InterfaceTypes.Contains(typeName))
            {
                flags |= ParameterFlag.Interface;
                flags &= ~ParameterFlag.Pointer; // Interface pointers are wrapped

                if (LightInterfaceTypes.Contains(typeName))
                {
                    flags |= ParameterFlag.LightInterface;
                }
            }
        }

        Name = name;
        TypeName = typeName;

        Indirection = indirection;
        Flags = flags;
    }

    private static string ToModifierPrefix(ParameterIndirection indirection) => indirection switch
    {
        ParameterIndirection.In => "in ",
        ParameterIndirection.Out => "out ",
        ParameterIndirection.Ref => "ref ",
        ParameterIndirection.RefReadonly => "ref readonly ",
        _ => "",
    };

    public string ToTypeDecl()
    {
        string typeDecl = TypeName;

        // Re-apply type modifiers
        if ((Flags & ParameterFlag.Pointer) != 0)
        {
            typeDecl += "*";
        }
        // Note that pointers cannot be nullable; the `else` is important here
        else if ((Flags & ParameterFlag.Nullable) != 0)
        {
            typeDecl += "?";
        }

        typeDecl = $"{ToModifierPrefix(Indirection)}{typeDecl}";

        return typeDecl;
    }

    public string ToFnPointerType()
    {
        string type = TypeName;

        if ((Flags & ParameterFlag.Interface) != 0)
        {
            // Interfaces must be marshalled as their pointer values
            type = "IntPtr";
        }

        type = ToModifierPrefix(Indirection) + type;

        // Re-apply pointer modifier
        if ((Flags & ParameterFlag.Pointer) != 0)
        {
            type += '*';
        }

        return type;
    }

    public string ToFnPointerArgument()
    {
        string argument = Name;

        if ((Flags & ParameterFlag.Interface) != 0)
        {
            // Handle interface marshalling
            if (Indirection == ParameterIndirection.Out)
            {
                // Interface handle being returned
                // Combines with modifier prefix to create `out IntPtr name_handle`
                argument = $"IntPtr {Name}_handle";
            }
            else if ((Flags & ParameterFlag.Nullable) != 0)
            {
                // Optional interface instance
                argument = $"{Name}?.DangerousGetHandle() ?? IntPtr.Zero";
            }
            else
            {
                // Required interface instance
                argument = $"{Name}.DangerousGetHandle()";
            }
        }

        argument = ToModifierPrefix(Indirection) + argument;

        return argument;
    }

    public static implicit operator InterfaceParameter((string TypeDecl, string Name) parameter)
        => new(parameter.TypeDecl, parameter.Name);
}

public struct InterfaceMethod
{
    public string Name;
    public Visibility Visibility;
    public InterfaceParameter ReturnType;
    public InterfaceParameter[] Parameters;

    public bool IsCustom;
    public Action CustomAction;

    public string VisModifier => Visibility switch
    {
        Visibility.Public => "public",
        Visibility.Internal => "internal",
        Visibility.Private => "private",
        _ => throw new System.Diagnostics.UnreachableException($"Invalid visibility {Visibility}")
    };

    public bool IsVoid => ReturnType.TypeName == "void";

    public InterfaceMethod(string returnType, string name, params InterfaceParameter[] parameters)
        : this(Visibility.Public, returnType, name, parameters)
    {
    }

    public InterfaceMethod(Visibility visibility, string returnType, string name, params InterfaceParameter[] parameters)
    {
        Name = name;
        Visibility = visibility;
        ReturnType = new(returnType, "<return>");
        Parameters = parameters;

        IsCustom = false;
        CustomAction = null;
    }

    public InterfaceMethod(Action customAction)
    {
        Name = "";
        Visibility = Visibility.Public;
        ReturnType = new("", "<return>");
        Parameters = Array.Empty<InterfaceParameter>();

        IsCustom = true;
        CustomAction = customAction;
    }
}

public struct InterfaceDecl(string name, string guid, bool light, params InterfaceMethod[] methods)
{
    public string Name = name;
    public string Guid = guid;
    public bool Light = light;
    public InterfaceMethod[] Methods = methods;
}

public struct HeaderNamespace
{
    public string Name;
    public string Condition;

    public static implicit operator HeaderNamespace(string name) => new()
    {
        Name = name,
        Condition = null,
    };

    public static implicit operator HeaderNamespace((string Name, string Condition) item) => new()
    {
        Name = item.Name,
        Condition = item.Condition,
    };
}

private class NamespaceSorter : IComparer<string>
{
    public int Compare(string left, string right)
    {
        static bool IsSystemNamespace(string ns)
        {
            int separatorIndex = ns.IndexOf('.');
            if (separatorIndex < 0)
            {
                separatorIndex = ns.Length;
            }

            return ns[0..separatorIndex] == "System";
        }

        bool leftSystem = IsSystemNamespace(left);
        bool rightSystem = IsSystemNamespace(right);
        return (leftSystem, rightSystem) switch
        {
            (true, false) => -1,
            (false, true) => 1,
            _ => left.CompareTo(right),
        };
    }
}
#>