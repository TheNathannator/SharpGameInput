void ForwardInterfaceMethods(InterfaceMethod[] methods)
{
    int vtableIndex = 0;

    // IUnknown methods
    // These are already provided through the Marshal class,
    // so we don't need to expose them ourselves
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "HRESULT", "QueryInterface", 
    //     ("REFIID", "riid"),
    //     ("out void*", "ppvObj")
    // ));
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "ULONG", "AddRef"));
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "ULONG", "Release"));
    vtableIndex += 3;

    // Other interface methods
    for (int i = 0; i < methods.Length; i++)
    {
        var method = methods[i];
        if (method.IsCustom)
        {
            method.CustomAction();
        }
        else
        {
            ForwardMethod(vtableIndex++, methods[i]);
        }
    }
}

