<#@ template hostspecific="false" language="C#" #>
<#@ output extension=".cs" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#+
#region Type declaration data

public enum Visibility
{
    Public,
    Internal,
    Private,
}

public enum Indirection
{
    None,
    In,
    Out,
    Ref,
    RefReadonly,
}

[Flags]
public enum Modifiers
{
    None = 0,

    Nullable = 0x01,
    ReadOnly = 0x02,
    Scoped   = 0x04,
    Pointer  = 0x08,

    NullableElements = 0x10,
    ReadOnlyElements = 0x20,
    PointerElements  = 0x40,

    Array = 0x100,
    Span  = 0x200,

    Interface      = 0x1000,
    LightInterface = 0x2000,
    OwnedInterface = 0x4000,
}

public struct ParameterDecl(string typeDecl, string name)
{
    public string TypeDecl = typeDecl;
    public string Name = name;

    public static implicit operator ParameterDecl((string TypeDecl, string Name) parameter)
        => new(parameter.TypeDecl, parameter.Name);
}

public struct MethodDecl
{
    public Visibility Visibility;
    public string ReturnTypeDecl;
    public string Name;
    public ParameterDecl[] Parameters;

    public bool IsCustom;
    public Action<TypeLibrary> CustomAction;

    public bool IsVoid => ReturnTypeDecl == "void";

    public MethodDecl(string returnTypeDecl, string name, params ParameterDecl[] parameters)
        : this(Visibility.Public, returnTypeDecl, name, parameters)
    {
    }

    public MethodDecl(Visibility visibility, string returnTypeDecl, string name, params ParameterDecl[] parameters)
    {
        Visibility = visibility;
        ReturnTypeDecl = returnTypeDecl;
        Name = name;
        Parameters = parameters;

        IsCustom = false;
        CustomAction = null;
    }

    public MethodDecl(Action<TypeLibrary> customAction)
    {
        Visibility = Visibility.Public;
        ReturnTypeDecl = "";
        Name = "";
        Parameters = Array.Empty<ParameterDecl>();

        IsCustom = true;
        CustomAction = customAction;
    }
}

public struct InterfaceDecl(string name, string guid, bool light, params MethodDecl[] methods)
{
    public string Name = name;
    public string Guid = guid;
    public bool IsLight = light;
    public MethodDecl[] Methods = methods;
}

public struct CallbackDecl(MethodDecl @delegate, MethodDecl register)
{
    public MethodDecl Delegate = @delegate;
    public MethodDecl Register = register;
}

#endregion

public struct ParsedType(string name, Indirection indirection, Modifiers modifiers)
{
    public string Name = name;
    public Indirection Indirection = indirection;
    public Modifiers Modifiers = modifiers;

    public bool IsVoid => Name == "void";
}

public class TypeLibrary
{
    // Type declarations to be entirely replaced before parsing them.
    // Replacements are performed recursively, so one replacement can alias directly to another.
    public readonly Dictionary<string, string> TypeDeclReplacements = new();

    // Type names to be substituted in function pointer declarations.
    // These replacements are NOT performed recursively
    public readonly Dictionary<string, string> FnPointerTypeReplacements = new();

    public InterfaceDecl[] Interfaces;
    public CallbackDecl[] Callbacks;

    public ParsedType ParseTypeDecl(string declaration)
    {
        // Swap out full declarations for their underlying declarations
        while (TypeDeclReplacements.TryGetValue(declaration, out string declReplacement))
        {
            declaration = declReplacement;
        }

        if (Callbacks.Any((c) => c.Delegate.Name == declaration))
        {
            declaration += "_NativePtr";
        }

        string typeName = declaration;
        var modifiers = Modifiers.None;
        var indirection = Indirection.None;

        // Prefix modifiers
        if (typeName.StartsWith("const "))
        {
            modifiers |= Modifiers.ReadOnly;
            typeName = typeName["const ".Length..];
        }
        if (typeName.StartsWith("owned ")) // Pseudo-syntax for owned interface instances that need to be released
        {
            modifiers |= Modifiers.OwnedInterface;
            typeName = typeName["owned ".Length..];
        }
        if (typeName.StartsWith("scoped "))
        {
            modifiers |= Modifiers.Scoped;
            typeName = typeName["scoped ".Length..];
        }

        // Value indirection
        if (typeName.StartsWith("in "))
        {
            indirection = Indirection.In;
            typeName = typeName["in ".Length..];
        }
        else if (typeName.StartsWith("out "))
        {
            indirection = Indirection.Out;
            typeName = typeName["out ".Length..];
        }
        else if (typeName.StartsWith("ref readonly "))
        {
            indirection = Indirection.RefReadonly;
            typeName = typeName["ref readonly ".Length..];
        }
        else if (typeName.StartsWith("ref "))
        {
            indirection = Indirection.Ref;
            typeName = typeName["ref ".Length..];
        }

        // Postfix modifiers
        // A pseudo-syntax for nullable pointer types is supported by using *?
        if (typeName.EndsWith("?"))
        {
            modifiers |= Modifiers.Nullable;
            typeName = typeName[..^1];
        }
        if (typeName.EndsWith("*"))
        {
            modifiers |= Modifiers.Pointer;
            typeName = typeName[..^1];
        }

        // Arrays
        if (typeName.EndsWith("[]"))
        {
            modifiers |= Modifiers.Array;
            modifiers |= Modifiers.ReadOnlyElements;
            typeName = typeName[..^2];
        }
        else if (typeName.EndsWith("[mut]"))
        {
            modifiers |= Modifiers.Array;
            typeName = typeName[..^5];
        }

        // Array element modifiers
        if ((modifiers & Modifiers.Array) != 0)
        {
            if (typeName.EndsWith("?"))
            {
                modifiers |= Modifiers.NullableElements;
                typeName = typeName[..^1];
            }
            if (typeName.EndsWith("*"))
            {
                modifiers |= Modifiers.PointerElements;
                typeName = typeName[..^1];
            }
        }

        // Special types

        // Spans
        if (typeName.StartsWith("Span"))
        {
            modifiers |= Modifiers.Span;

            typeName = ExtractGenericType(typeName);
        }
        else if (typeName.StartsWith("ReadOnlySpan"))
        {
            modifiers |= Modifiers.Span;
            modifiers |= Modifiers.ReadOnlyElements;

            typeName = ExtractGenericType(typeName);
        }

        // Interfaces
        foreach (var iface in Interfaces)
        {
            if (typeName == iface.Name)
            {
                modifiers |= Modifiers.Interface;
                modifiers &= ~Modifiers.Pointer; // Interfaces are marshalled
                break;
            }
            else if (iface.IsLight &&
                typeName.StartsWith("Light") &&
                typeName["Light".Length..] == iface.Name)
            {
                modifiers |= (Modifiers.Interface | Modifiers.LightInterface);
                modifiers &= ~Modifiers.Pointer; // Interfaces are marshalled
            }
        }

        return new(typeName, indirection, modifiers);
    }

    public string ToCodeType(string typeDecl)
    {
        var type = ParseTypeDecl(typeDecl);
        return ToCodeType(type);
    }

    public string ToCodeType(ParsedType type)
    {
        string typeName = type.Name;
        string prefix = "";
        string postfix = "";

        // Prefix modifiers
        if ((type.Modifiers & Modifiers.Scoped) != 0)
        {
            prefix += "scoped ";
        }

        prefix += ToPrefix(type.Indirection);

        // Postfix modifiers
        if ((type.Modifiers & Modifiers.Pointer) != 0)
        {
            postfix += "*";
        }
        // Note that pointers cannot be explicitly nullable in C#; the `else` is important here
        else if ((type.Modifiers & Modifiers.Nullable) != 0)
        {
            postfix += "?";
        }

        // Array elements
        string elementSuffix;
        if ((type.Modifiers & Modifiers.PointerElements) != 0)
        {
            elementSuffix = "*";
        }
        // Note that pointers cannot be explicitly nullable in C#; the `else` is important here
        else if ((type.Modifiers & Modifiers.NullableElements) != 0)
        {
            elementSuffix = "?";
        }
        else
        {
            elementSuffix = "";
        }

        // Arrays
        if ((type.Modifiers & Modifiers.Array) != 0)
        {
            postfix = elementSuffix + "[]" + postfix;
        }
        else if ((type.Modifiers & Modifiers.Span) != 0)
        {
            if ((type.Modifiers & Modifiers.ReadOnlyElements) != 0)
            {
                typeName = $"ReadOnlySpan<{typeName}>";
            }
            else
            {
                typeName = $"Span<{typeName}>";
            }
        }

        return $"{prefix}{typeName}{postfix}";
    }

    public string ToFnPointerType(string typeDecl)
    {
        var type = ParseTypeDecl(typeDecl);
        return ToFnPointerType(type);
    }

    public string ToFnPointerType(ParsedType type)
    {
        string resultType = type.Name;

        // Interfaces need to be marshalled
        if ((type.Modifiers & Modifiers.Interface) != 0)
        {
            resultType = "IntPtr";
        }
        else if (FnPointerTypeReplacements.TryGetValue(resultType, out string replacement))
        {
            resultType = replacement;
        }

        resultType = ToPrefix(type.Indirection) + resultType;

        // Re-apply pointer modifier
        if ((type.Modifiers & Modifiers.Pointer) != 0)
        {
            resultType += '*';
        }

        return resultType;
    }

    public string ToCodeParameter(ParameterDecl parameter)
    {
        return $"{ToCodeType(parameter.TypeDecl)} {parameter.Name}";
    }

    public string ToFnPointerParameter(ParameterDecl parameter)
    {
        return $"{ToFnPointerType(parameter.TypeDecl)} {parameter.Name}";
    }

    public string ToFnPointerArgument(ParameterDecl parameter)
    {
        string argument = parameter.Name;
        var paramType = ParseTypeDecl(parameter.TypeDecl);

        // Interfaces need to be marshalled
        if ((paramType.Modifiers & Modifiers.Interface) != 0)
        {
            if (paramType.Indirection == Indirection.Out)
            {
                // Interface handle being returned
                // Combines with modifier prefix to create `out IntPtr name_handle`
                argument = $"IntPtr {parameter.Name}_handle";
            }
            else if ((paramType.Modifiers & Modifiers.Nullable) != 0)
            {
                // Optional interface instance
                argument = $"{parameter.Name}?.DangerousGetHandle() ?? IntPtr.Zero";
            }
            else
            {
                // Required interface instance
                argument = $"{parameter.Name}.DangerousGetHandle()";
            }
        }

        // Booleans need to be marshalled
        if (paramType.Name == "bool" && paramType.Modifiers == Modifiers.None)
        {
            argument = $"{parameter.Name} ? (byte)1 : (byte)0";
        }

        argument = ToPrefix(paramType.Indirection) + argument;

        return argument;
    }

    public string MarshalFromFnPointerParameter(ParameterDecl parameter)
    {
        var paramType = ParseTypeDecl(parameter.TypeDecl);
        return MarshalFromFnPointerParameter(paramType, parameter.Name);
    }

    public string MarshalFromFnPointerParameter(ParsedType paramType, string paramName)
    {
        string result = paramName;

        // Interfaces need to be marshalled
        if ((paramType.Modifiers & Modifiers.Interface) != 0)
        {
            string owned = (paramType.Modifiers & Modifiers.OwnedInterface) != 0 ? "true" : "false";
            result = $"new {paramType.Name}({paramName}, {owned})";
        }

        // Booleans need to be marshalled
        if (paramType.Name == "bool" && paramType.Modifiers == Modifiers.None)
        {
            result = $"{paramName} != 0";
        }

        result = ToPrefix(paramType.Indirection) + result;

        return result;
    }

    public string ToCodeMethodFront(MethodDecl method)
    {
        return $"{ToModifier(method.Visibility)} {ToCodeType(method.ReturnTypeDecl)} {method.Name}";
    }

    public string MethodToFnPointerType(MethodDecl method)
    {
        if (method.IsCustom)
        {
            throw new InvalidOperationException($"Cannot create string representation of custom-action methods");
        }

        var args = method.Parameters
            .Select(p => ToFnPointerType(p.TypeDecl))
            .Append(ToFnPointerType(method.ReturnTypeDecl));

        return $"delegate* unmanaged[Stdcall]<{string.Join(", ", args)}>";
    }

    public string ToModifier(Visibility visibility)
    {
        return visibility switch
        {
            Visibility.Public => "public",
            Visibility.Internal => "internal",
            Visibility.Private => "private",
            _ => "",
        };
    }

    public string ToPrefix(Indirection indirection)
    {
        return indirection switch
        {
            Indirection.In => "in ",
            Indirection.Out => "out ",
            Indirection.Ref => "ref ",
            Indirection.RefReadonly => "ref readonly ",
            _ => "",
        };
    }

    private static string ExtractGenericType(string typeName)
    {
        int start = -1;
        int end = -1;

        int depth = 0;
        for (int i = 0; i < typeName.Length; i++)
        {
            char c = typeName[i];
            if (c == '<')
            {
                depth++;
                if (depth > 0)
                {
                    start = i + 1;
                }
            }
            else if (c == '>')
            {
                depth--;
                if (depth <= 0)
                {
                    end = i;
                }
            }
        }

        return typeName[start..end];
    }
}

#>