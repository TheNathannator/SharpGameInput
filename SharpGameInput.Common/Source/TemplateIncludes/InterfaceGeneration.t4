<#
TypeLibrary MakeInterfaceTypeLibrary()
{
    return new()
    {
        TypeDeclReplacements =
        {
            { "REFIID", "ref IID" },
            { "IUnknown*", "IntPtr" },
        },
        FnPointerTypeReplacements =
        {
            {"object", "void*"},
            {"bool", "byte"},
            {"GameInputCallbackToken", "ulong"},
            {"LightGameInputCallbackToken", "ulong"},
        },
    };
}

void WriteInterfaces(TypeLibrary library)
{
    // Apply shared callback parameters
    for (int i = 0; i < library.Callbacks.Length; i++)
    {
        ref var callback = ref library.Callbacks[i];
        callback.Delegate.Parameters =
        [
            ("LightGameInputCallbackToken", "callbackToken"),
            ("object?", "context"),
            ..callback.Delegate.Parameters,
        ];
    }

#>
    #region Native callback definitions

<#
    foreach (var callback in library.Callbacks)
    {
        var del = callback.Delegate;
#>
    using unsafe <#= del.Name #>_NativePtr = delegate* unmanaged[Stdcall]<
<#
        foreach (var parameter in del.Parameters)
        {
#>
        <#= library.ToFnPointerType(parameter.TypeDecl) #>, // <#= parameter.Name #>
<#
        }
#>
        <#= library.ToFnPointerType(del.ReturnTypeDecl) #> // <return>
    >;

<#
    }
#>
    #endregion

    #region Managed callback definitions

<#
    foreach (var callback in library.Callbacks)
    {
        var del = callback.Delegate;
#>
    <#= library.ToModifier(del.Visibility) #> delegate <#= library.ToCodeType(del.ReturnTypeDecl) #> <#= del.Name #>(
<#
        for (int i = 0; i < del.Parameters.Length; i++)
        {
            var parameter = del.Parameters[i];
            // Can't use a comma on the last argument
            string delimiter = i < del.Parameters.Length - 1 ? "," : "";
#>
        <#= library.ToCodeParameter(parameter) #><#= delimiter #>
<#
        }
#>
    );

<#
    }
#>
    #endregion

    #region Interface definitions

<#@ include file="../InlineFiles/GameInputComPtr.inl.cs" #>
<#
    foreach (var iface in library.Interfaces)
    {
#>

    [Guid("<#= iface.Guid #>")]
    public sealed unsafe partial class <#= iface.Name #> : GameInputComPtr,
        IEquatable<<#= iface.Name #>>
    {
        internal static readonly Guid Iid = new("<#= iface.Guid #>");

        internal <#= iface.Name #>(IntPtr handle, bool ownsHandle) : base(handle, ownsHandle) { }

        public <#= iface.Name #> Duplicate()
        {
            Marshal.AddRef(handle);
            return new(handle, ownsHandle: true);
        }
<#
        WriteInterfaceMethods(library, iface);
#>

        public bool Equals([NotNullWhen(true)] <#= iface.Name #>? ptr)
            => this == ptr;
<#
        if (iface.IsLight)
        {
#>

        public bool Equals(Light<#= iface.Name #> obj)
            => this == obj;
    }

    public unsafe ref partial struct Light<#= iface.Name #>
    {
        internal IntPtr handle;
        private bool ownsHandle;

        public bool IsInvalid => handle == IntPtr.Zero;

        internal Light<#= iface.Name #>(IntPtr handle, bool ownsHandle)
        {
            this.handle = handle;
            this.ownsHandle = ownsHandle;
        }

        public void Dispose()
        {
            if (handle != IntPtr.Zero && ownsHandle)
            {
                Marshal.Release(handle);
                handle = IntPtr.Zero;
            }
        }

        public IntPtr DangerousGetHandle() => handle;

        public <#= iface.Name #> ToComPtr()
        {
            // Move handle to the new instance
            var handle = this.handle;
            this.handle = IntPtr.Zero;
            return new(handle, ownsHandle);
        }

        public static implicit operator Light<#= iface.Name #>(<#= iface.Name #> instance)
        {
            return new(instance.DangerousGetHandle(), ownsHandle: false);
        }

        public static bool operator ==(Light<#= iface.Name #> left, Light<#= iface.Name #> right)
        {
            // GameInput interfaces can be compared directly by pointer for equality
            return left.handle == right.handle;
        }

        public static bool operator ==(<#= iface.Name #>? left, Light<#= iface.Name #> right)
        {
            return left?.handle == right.handle;
        }

        public static bool operator ==(Light<#= iface.Name #> left, <#= iface.Name #>? right)
        {
            return left.handle == right?.handle;
        }

        public static bool operator !=(Light<#= iface.Name #> left, Light<#= iface.Name #> right)
            => !(left == right);

        public static bool operator !=(<#= iface.Name #>? left, Light<#= iface.Name #> right)
            => !(left == right);

        public static bool operator !=(Light<#= iface.Name #> left, <#= iface.Name #>? right)
            => !(left == right);

        public readonly bool Equals(Light<#= iface.Name #> obj)
            => this == obj;

        public readonly bool Equals(<#= iface.Name #>? obj)
            => this == obj;

#pragma warning disable CS0809 // Obsolete member overrides non-obsolete member
        [Obsolete("Equals(object) on Light<#= iface.Name #> will always throw an exception. Use the equality operator instead.", true)]
        public override bool Equals(object? obj)
            => throw new NotSupportedException();
#pragma warning restore CS0809

        public override int GetHashCode()
            => handle.GetHashCode();
<#
            WriteInterfaceMethods(library, iface);
        }
#>
    }
<#
    }
#>

    #endregion

    #region Callback implementations

    public unsafe partial class IGameInput
    {
<#
    foreach (var callback in library.Callbacks)
    {
        var del = callback.Delegate;
#>
        private delegate <#= library.ToFnPointerType(del.ReturnTypeDecl) #> <#= del.Name #>_Native(
<#
        for (int i = 0; i < del.Parameters.Length; i++)
        {
            var parameter = del.Parameters[i];
            // Can't use a comma on the last argument
            if (i < del.Parameters.Length - 1)
            {
#>
            <#= library.ToFnPointerParameter(parameter) #>,
<#
            }
            else
            {
#>
            <#= library.ToFnPointerParameter(parameter) #>
<#
            }
        }
#>
        );

<#
    }
#>
#if NET5_0_OR_GREATER
<#
    foreach (var callback in library.Callbacks)
    {
        var del = callback.Delegate;
#>
        private static readonly <#= del.Name #>_NativePtr _<#= del.Name #>Ptr = &_<#= del.Name #>;
<#
    }
#>
#else
<#
    foreach (var callback in library.Callbacks)
    {
        var del = callback.Delegate;
#>
        private static readonly <#= del.Name #>_Native _<#= del.Name #>Delegate = _<#= del.Name #>;
<#
    }
#>

<#
    foreach (var callback in library.Callbacks)
    {
        var del = callback.Delegate;
#>
        private static readonly <#= del.Name #>_NativePtr _<#= del.Name #>Ptr = (<#= del.Name #>_NativePtr)
            Marshal.GetFunctionPointerForDelegate(_<#= del.Name #>Delegate);
<#
    }
#>
#endif
<#
    foreach (var callback in library.Callbacks)
    {
#>

        public bool <#= callback.Register.Name #>(
<#
        foreach (var parameter in callback.Register.Parameters)
        {
#>
            <#= library.ToCodeParameter(parameter) #>,
<#
        }
#>
            object? context,
            <#= callback.Delegate.Name #> callbackFunc,
            [NotNullWhen(true)] out GameInputCallbackToken? callbackToken,
            out int result
        )
        {
            ThrowHelper.CheckNull(callbackFunc);

            using var scope = _callbacks.StartRegisteringCallback(callbackFunc, context);
            result = _<#= callback.Register.Name #>(
<#
        foreach (var parameter in callback.Register.Parameters)
        {
#>
                <#= parameter.Name #>,
<#
        }
#>
                _callbacks.MakeCallbackContext(this),
                _<#= callback.Delegate.Name #>Ptr,
                out ulong token
            );

            bool success = scope.Finish(result, token);
            callbackToken = success ? new(this, token) : null;
            return success;
        }
<#
    }

    foreach (var callback in library.Callbacks)
    {
        var del = callback.Delegate;
#>

#if NET5_0_OR_GREATER
        [UnmanagedCallersOnly(CallConvs = new[] { typeof(CallConvStdcall) })]
#endif
#if SHARPGAMEINPUT_UNITY
        [AOT.MonoPInvokeCallback(typeof(<#= del.Name #>_Native))]
#endif
        private static <#= library.ToFnPointerType(del.ReturnTypeDecl) #> _<#= del.Name #>(
<#
        for (int i = 0; i < del.Parameters.Length; i++)
        {
            var parameter = del.Parameters[i];
            // Can't use a comma on the last argument
            string delimiter = i < del.Parameters.Length - 1 ? "," : "";
#>
            <#= library.ToFnPointerParameter(parameter) #><#= delimiter #>
<#
        }
#>
        )
        {
            IGameInput gameInput = null!;
            try
            {
                gameInput = CallbackRegistrar<IGameInput>.ContextToInstance(context);
                var (_callbackFunc, callbackContext) = gameInput._callbacks.GetCallback(callbackToken);
                var callbackFunc = (<#= del.Name #>)_callbackFunc;

                <#= del.IsVoid ? "" : "return " #>callbackFunc(
<#

        for (int i = 0; i < del.Parameters.Length; i++)
        {
            var parameter = del.Parameters[i];
            string delimiter = i < del.Parameters.Length - 1 ? "," : "";
            switch (parameter.Name)
            {
                case "callbackToken":
                {
#>
                    new LightGameInputCallbackToken(gameInput, callbackToken)<#= delimiter #>
<#
                    break;
                }
                case "context":
                {
#>
                    callbackContext<#= delimiter #>
<#
                    break;
                }
                default:
                {
