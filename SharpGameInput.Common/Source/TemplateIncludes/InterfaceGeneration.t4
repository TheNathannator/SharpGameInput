void WriteInterfaceMethods(TypeLibrary library, in InterfaceDecl iface)
{
    int vtableIndex = 0;

    // IUnknown methods
    // These are already provided through the Marshal class,
    // so we don't need to expose them ourselves
    // WriteInterfaceMethod(vtableIndex++, new(Visibility.Internal, "HRESULT", "QueryInterface", 
    //     ("REFIID", "riid"),
    //     ("out void*", "ppvObj")
    // ));
    // WriteInterfaceMethod(vtableIndex++, new(Visibility.Internal, "ULONG", "AddRef"));
    // WriteInterfaceMethod(vtableIndex++, new(Visibility.Internal, "ULONG", "Release"));
    vtableIndex += 3;

    // Other interface methods
    for (int i = 0; i < iface.Methods.Length; i++)
    {
        var method = iface.Methods[i];
        if (method.IsCustom)
        {
            method.CustomAction(library);
        }
        else
        {
            WriteInterfaceMethod(library, iface, method, vtableIndex++);
        }
    }
}

void WriteInterfaceMethod(TypeLibrary library, in InterfaceDecl iface, MethodDecl method, int vtableIndex)
{
    var fnPtrTypes = method.Parameters
        .Select((p) => library.ToFnPointerType(p.TypeDecl))
        .Prepend("IntPtr")
        .Append(library.ToFnPointerType(method.ReturnTypeDecl));

    var fnCallArgs = method.Parameters
        .Select((p) => library.ToFnPointerArgument(p))
        .Prepend("thisPtr");

    string fnPtrType = $"delegate* unmanaged[Stdcall]<{string.Join(", ", fnPtrTypes)}>";

    // Make the generated code look a little nicer if there's no parameters
    if (method.Parameters.Length < 1)
    {
#>

        <#= library.ToCodeMethodFront(method) #>()
<#
    }
    else
    {
#>

        <#= library.ToCodeMethodFront(method) #>(
<#
        for (int i = 0; i < method.Parameters.Length; i++)
        {
            var parameter = method.Parameters[i];
            // Can't use a comma on the last argument
            string delimiter = i < method.Parameters.Length - 1 ? "," : "";
#>
            <#= library.ToCodeParameter(parameter) #><#= delimiter #>
<#
        }
#>
        )
<#
    }
#>
        {
            ThrowHelper.CheckDisposed(IsInvalid, typeof(<#= iface.Name #>));
<#
    foreach (var parameter in method.Parameters)
    {
        var paramType = library.ParseTypeDecl(parameter.TypeDecl);
        var modifiers = paramType.Modifiers;

        // Don't check output or optional parameters
        if (paramType.Indirection == Indirection.Out || (modifiers & Modifiers.Nullable) != 0)
            continue;

        // Verify input handle types
        if ((modifiers & Modifiers.LightInterface) != 0)
        {
#>
            ThrowHelper.CheckDisposed(<#= parameter.Name #>.IsInvalid, typeof(<#= paramType.Name #>));
<#
        }
        else if ((modifiers & Modifiers.Interface) != 0)
        {
#>
            ThrowHelper.CheckNull(<#= parameter.Name #>);
            ThrowHelper.CheckDisposed(<#= parameter.Name #>.IsInvalid, typeof(<#= paramType.Name #>));
<#
        }
        // Verify pointer types
        else if ((modifiers & Modifiers.Pointer) != 0)
        {
#>
            ThrowHelper.CheckNull(<#= parameter.Name #>);
<#
        }
    }
#>

            var thisPtr = handle;
            var vtable = *(void***)thisPtr;
            var fnPtr = (<#= fnPtrType #>)vtable[<#= vtableIndex #>];

<#
    var returnType = library.ParseTypeDecl(method.ReturnTypeDecl);
    if (method.IsVoid)
    {
#>
            fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#
    }
    else
    {
        // Allow returning by indirection
        if (returnType.Indirection is Indirection.Ref)
        {
#>
            ref var result = ref fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#
        }
        else if (returnType.Indirection is Indirection.RefReadonly)
        {
#>
            ref readonly var result = ref fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#
        }
        else
        {
#>
            var result = fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#
        }
    }

    foreach (var parameter in method.Parameters)
    {
        var paramType = library.ParseTypeDecl(parameter.TypeDecl);
        if ((paramType.Modifiers & Modifiers.Interface) != 0)
        {
            if (paramType.Indirection == Indirection.Out)
            {
#>
            <#= parameter.Name #> = new(<#= parameter.Name #>_handle, ownsHandle: true);
<#
            }
        }
    }

    if (!method.IsVoid)
    {
        if (returnType.Indirection is Indirection.Ref or Indirection.RefReadonly)
        {
#>
            return ref result;
<#
        }
        else
        {
#>
            return <#= library.MarshalFromFnPointerParameter(returnType, "result") #>;
<#
        }
    }
#>
        }
<#
}
#>
<#+
public void MakeArrayWrappers(
    string returnTypeDecl,
    string name,

    TypeLibrary library,

    string castLengthTo,
    bool lengthBeforePtr,

    params ParameterDecl[] parameters
)
{
    var returnType = library.ParseTypeDecl(returnTypeDecl);

    void MakeArrayMethodBody()
    {
#>
        {
<#+
        for (int i = 0; i < parameters.Length; i++)
        {
            var parameter = parameters[i];
            var paramType = library.ParseTypeDecl(parameter.TypeDecl);

            if ((paramType.Modifiers & Modifiers.Array) != 0)
            {
#>
            fixed (<#= paramType.Name #>* <#= parameter.Name #>Ptr = <#= parameter.Name #>)
<#+
            }
        }
#>
            {
                <#= returnType.IsVoid ? "" : "return " #><#= name #>(
<#+
        for (int i = 0; i < parameters.Length; i++)
        {
            var parameter = parameters[i];
            var paramType = library.ParseTypeDecl(parameter.TypeDecl);

            // Can't use a comma on the last argument
            string delimiter = i < parameters.Length - 1 ? "," : "";

            if ((paramType.Modifiers & Modifiers.Array) != 0)
            {
                string lengthCast = castLengthTo != null ? $"({castLengthTo})" : "";
                string arrayLength = (paramType.Modifiers & Modifiers.NullableArray) != 0
                    ? lengthCast + $"({parameter.Name}?.Length ?? 0)"
                    : lengthCast + $"{parameter.Name}.Length";
                if (lengthBeforePtr)
                {
#>
                    <#= arrayLength #>,
                    <#= parameter.Name #>Ptr<#= delimiter #>
<#+
                }
                else
                {
#>
                    <#= parameter.Name #>Ptr,
                    <#= arrayLength #><#= delimiter #>
<#+
                }
            }
            else
            {
#>
                    <#= library.ToFnPointerArgument(parameter) #><#= delimiter #>
<#+
            }
        }
#>
                );
            }
        }
<#+
    }

#>

        public <#= library.ToCodeType(returnType) #> <#= name #>(
<#+
    for (int i = 0; i < parameters.Length; i++)
    {
        var parameter = parameters[i];
        var paramType = library.ParseTypeDecl(parameter.TypeDecl);

        // Can't use a comma on the last parameter
        string delimiter = i < parameters.Length - 1 ? "," : "";

#>
            <#= library.ToCodeParameter(parameter) #><#= delimiter #>
<#+
    }
#>
        )
<#+
    MakeArrayMethodBody();

#>

#if NETSTANDARD2_1_OR_GREATER
        public <#= library.ToCodeType(returnType) #> <#= name #>(
<#+
    for (int i = 0; i < parameters.Length; i++)
    {
        var parameter = parameters[i];
        var paramType = library.ParseTypeDecl(parameter.TypeDecl);

        // Can't use a comma on the last parameter
        string delimiter = i < parameters.Length - 1 ? "," : "";

        if ((paramType.Modifiers & Modifiers.Array) != 0)
        {
            // Spans are value types, and cannot have null instances
            paramType.Modifiers &= ~Modifiers.NullableArray;
            parameters[i] = parameter;

            if ((paramType.Modifiers & Modifiers.ReadOnlyArray) != 0)
            {
#>
            scoped System.ReadOnlySpan<<#= paramType.Name #>> <#= parameter.Name #><#= delimiter #>
<#+
            }
            else
            {
#>
            scoped System.Span<<#= paramType.Name #>> <#= parameter.Name #><#= delimiter #>
<#+
            }
        }
        else
        {
#>
            <#= library.ToCodeParameter(parameter) #><#= delimiter #>
<#+
        }
    }
#>
        )
<#+
    MakeArrayMethodBody();
#>
#endif
<#+
}
#>