<#@ template hostspecific="false" language="C#" #>
<#@ output extension=".cs" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#
void MakeGeneratedFile(string @namespace, Action makeContents)
{
    // Header comment
#>
//------------------------------------------------------------------------------
// <auto-generated>
//     This code was generated from a text template.
//     Changes to this file may cause incorrect behavior and will be lost if
//     the code is regenerated.
// </auto-generated>
//------------------------------------------------------------------------------
<#

    // Using directives
    var usings = new SortedDictionary<string, string>(new NamespaceSorter());
    foreach (var ns in UsingDirectives)
    {
        if (usings.TryGetValue(ns.Name, out string condition))
        {
            if (condition != null && ns.Condition == null)
            {
                usings[ns.Name] = null;
            }
            continue;
        }

        usings.Add(ns.Name, ns.Condition);
    }

    foreach (var (ns, condition) in usings)
    {
        if (condition != null)
        {
#>
#if <#= condition #>
<#
        }
#>
using <#= ns #>;
<#
        if (condition != null)
        {
#>
#endif
<#
        }
    }
#>

#nullable enable

namespace <#= @namespace #>
{
<#
    // Type aliases
    if (TypeAliases.Count > 0)
    {
#>
    #region Type aliases

<#
        foreach (var (name, _type) in TypeAliases)
        {
            string type = _type;
            while (TypeAliases.TryGetValue(type, out string newType))
            {
                type = newType;
            }
#>
    using <#= name #> = <#= type #>;
<#
        }
#>

    #endregion

<#
    }

    makeContents();
#>
}
<#
}
#>
<#+
public List<UsingNamespace> UsingDirectives = new();
public SortedDictionary<string, string> TypeAliases = new();

public struct UsingNamespace
{
    public string Name;
    public string Condition;

    public static implicit operator UsingNamespace(string name) => new()
    {
        Name = name,
        Condition = null,
    };

    public static implicit operator UsingNamespace((string Name, string Condition) item) => new()
    {
        Name = item.Name,
        Condition = item.Condition,
    };
}

private class NamespaceSorter : IComparer<string>
{
    public int Compare(string left, string right)
    {
        static bool IsSystemNamespace(string ns)
        {
            int separatorIndex = ns.IndexOf('.');
            if (separatorIndex < 0)
            {
                separatorIndex = ns.Length;
            }

            return ns[0..separatorIndex] == "System";
        }

        bool leftSystem = IsSystemNamespace(left);
        bool rightSystem = IsSystemNamespace(right);
        return (leftSystem, rightSystem) switch
        {
            (true, false) => -1,
            (false, true) => 1,
            _ => left.CompareTo(right),
        };
    }
}
#>