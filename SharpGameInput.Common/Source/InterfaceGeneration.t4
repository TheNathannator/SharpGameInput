<#@ template hostspecific="false" language="C#" #>
<#@ output extension=".cs" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#
UsingDirectives.Add("System");
UsingDirectives.Add("System.Diagnostics.CodeAnalysis");
UsingDirectives.Add("System.Runtime.InteropServices");
UsingDirectives.Add("SharpGameInput.Common");
#>
<#@ include file="GeneratedFileHeader.t4" once="true" #>
<#@ include file="TypeParsing.t4" once="true" #>
namespace <#= Namespace #>
{
<#
foreach (var _iface in Interfaces)
{
    var iface = _iface.ToDecl();
#>
    [Guid("<#= iface.Guid #>")]
    public sealed unsafe partial class <#= iface.Name #> : GameInputComPtr<<#= iface.Name #>>
    {
        internal static readonly Guid Iid = new("<#= iface.Guid #>");

        internal <#= iface.Name #>(IntPtr handle, bool ownsHandle) : base(handle, ownsHandle) { }

        protected override <#= iface.Name #> DuplicateImpl() => new(handle, true);
<#
    ForwardInterfaceMethods(iface.Methods);
    if (iface.IsLight)
    {
#>

        public bool Equals(Light<#= iface.Name #> obj)
            => obj == this;
    }

    public unsafe ref partial struct Light<#= iface.Name #>
    {
        internal IntPtr handle;
        private bool ownsHandle;

        public bool IsInvalid => handle == IntPtr.Zero;

        internal Light<#= iface.Name #>(IntPtr handle, bool ownsHandle)
        {
            this.handle = handle;
            this.ownsHandle = ownsHandle;
        }

        public void Dispose()
        {
            if (handle != IntPtr.Zero && ownsHandle)
            {
                Marshal.Release(handle);
                handle = IntPtr.Zero;
            }
        }

        public IntPtr DangerousGetHandle() => handle;

        public <#= iface.Name #> ToComPtr()
        {
            // Move handle to the new instance
            var handle = this.handle;
            this.handle = IntPtr.Zero;
            return new(handle, ownsHandle);
        }

        public static implicit operator Light<#= iface.Name #>(<#= iface.Name #> instance)
        {
            return new(instance.DangerousGetHandle(), ownsHandle: false);
        }

        public static bool operator ==(Light<#= iface.Name #> left, Light<#= iface.Name #> right)
        {
            // GameInput interfaces can be compared directly by pointer for equality
            return left.handle == right.handle;
        }

        public static bool operator ==(<#= iface.Name #>? left, Light<#= iface.Name #> right)
        {
            return left?.handle == right.handle;
        }

        public static bool operator ==(Light<#= iface.Name #> left, <#= iface.Name #>? right)
        {
            return left.handle == right?.handle;
        }

        public static bool operator !=(Light<#= iface.Name #> left, Light<#= iface.Name #> right)
            => !(left == right);

        public static bool operator !=(<#= iface.Name #>? left, Light<#= iface.Name #> right)
            => !(left == right);

        public static bool operator !=(Light<#= iface.Name #> left, <#= iface.Name #>? right)
            => !(left == right);

        public bool Equals(Light<#= iface.Name #> obj)
            => obj == this;

        public bool Equals(<#= iface.Name #> obj)
            => obj == this;

#pragma warning disable CS0809 // Obsolete member overrides non-obsolete member
        [Obsolete("Equals(object) on Light<#= iface.Name #> will always throw an exception. Use the equality operator instead.", true)]
        public override bool Equals(object? obj)
            => throw new NotSupportedException();
#pragma warning restore CS0809

        public override int GetHashCode()
            => handle.GetHashCode();
<# ForwardInterfaceMethods(iface.Methods); #>
<#
    }
#>
    }

<#
}

void ForwardInterfaceMethods(MethodDecl[] methods)
{
    int vtableIndex = 0;

    // IUnknown methods
    // These are already provided through the Marshal class,
    // so we don't need to expose them ourselves
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "HRESULT", "QueryInterface", 
    //     ("REFIID", "riid"),
    //     ("out void*", "ppvObj")
    // ));
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "ULONG", "AddRef"));
    // ForwardMethod(vtableIndex++, new(Visibility.Internal, "ULONG", "Release"));
    vtableIndex += 3;

    // Other interface methods
    for (int i = 0; i < methods.Length; i++)
    {
        var method = methods[i];
        if (method.IsCustom)
        {
            method.CustomAction();
        }
        else
        {
            ForwardMethod(vtableIndex++, methods[i]);
        }
    }
}

void ForwardMethod(int vtableIndex, MethodDecl method)
{
    var fnPtrTypes = method.Parameters.Select((p) => p.Type.ToFnPointerType()).Prepend("IntPtr").Append(method.ReturnType.ToTypeDecl());
    var fnCallArgs = method.Parameters.Select((p) => p.ToFnPointerArgument()).Prepend("thisPtr");
    string fnPtrType = $"delegate* unmanaged[Stdcall]<{string.Join(", ", fnPtrTypes)}>";

    // Make the generated code look a little nicer if there's no parameters
    if (method.Parameters.Length < 1)
    {
#>

        <#= method.VisModifier #> <#= method.ReturnType.ToTypeDecl() #> <#= method.Name #>()
<#
    }
    else
    {
#>

        <#= method.VisModifier #> <#= method.ReturnType.ToTypeDecl() #> <#= method.Name #>(
<#
        for (int i = 0; i < method.Parameters.Length; i++)
        {
            var parameter = method.Parameters[i];
            // Can't use a comma on the last argument
            string delimiter = i < method.Parameters.Length - 1 ? "," : "";
#>
            <#= parameter.Type.ToTypeDecl() #> <#= parameter.Name #><#= delimiter #>
<#
        }
#>
        )
<#
    }
#>
        {
            ThrowHelper.CheckDisposed(IsInvalid, "this");
<#
    foreach (var parameter in method.Parameters)
    {
        var flags = parameter.Type.Flags;

        // Don't check output or optional parameters
        if (parameter.Type.Indirection == TypeIndirection.Out || (flags & TypeFlag.Nullable) != 0)
            continue;

        // Verify input handle types
        if ((flags & TypeFlag.LightInterface) != 0)
        {
#>
            ThrowHelper.CheckDisposed(<#= parameter.Name #>.IsInvalid, nameof(<#= parameter.Name #>));
<#
        }
        else if ((flags & TypeFlag.Interface) != 0)
        {
#>
            ThrowHelper.CheckHandle(<#= parameter.Name #>);
<#
        }
        // Verify pointer types
        else if ((flags & TypeFlag.Pointer) != 0)
        {
#>
            ThrowHelper.CheckNull(<#= parameter.Name #>);
<#
        }
    }
#>

            var thisPtr = handle;
            var vtable = *(void***)thisPtr;
            var fnPtr = (<#= fnPtrType #>)vtable[<#= vtableIndex #>];

<#
    if (method.IsVoid)
    {
#>
            fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#
    }
    else
    {
        // Allow returning by indirection
        if (method.ReturnType.Indirection is TypeIndirection.Ref)
        {
#>
            ref var result = ref fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#
        }
        else if (method.ReturnType.Indirection is TypeIndirection.RefReadonly)
        {
#>
            ref readonly var result = ref fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#
        }
        else
        {
#>
            var result = fnPtr(
                <#= string.Join(",\n                ", fnCallArgs) #>
            );

<#
        }
    }

    foreach (var parameter in method.Parameters)
    {
        if ((parameter.Type.Flags & TypeFlag.Interface) != 0)
        {
            if (parameter.Type.Indirection == TypeIndirection.Out)
            {
#>
            <#= parameter.Name #> = new(<#= parameter.Name #>_handle, ownsHandle: true);
<#
            }
        }
    }

    if (!method.IsVoid)
    {
        if (method.ReturnType.Indirection is TypeIndirection.Ref or TypeIndirection.RefReadonly)
        {
#>
            return ref result;
<#
        }
        else
        {
#>
            return result;
<#
        }
    }
#>
        }
<#
}
#>
}