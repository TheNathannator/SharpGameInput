<Project>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <UsingTask
    TaskName="MakeVersionDefines"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Version ParameterType="System.Int32" />
      <InputDefines ParameterType="System.String" />
      <OutputDefines ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          string defines = InputDefines;

          string def = $"GAMEINPUT_V{Version}";
          if (string.IsNullOrEmpty(defines))
          {
            defines = def;
          }
          else
          {
            defines += ";" + def;
          }

          for (int i = 0; i <= Version; i++)
          {
            defines += $";GAMEINPUT_V{i}_OR_GREATER";
          }

          OutputDefines = defines;
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="CreateProperties" BeforeTargets="BeforeResolveReferences">
    <MakeVersionDefines Version="$(GameInputApiVersion)" InputDefines="$(DefineConstants)">
      <Output TaskParameter="OutputDefines" PropertyName="DefineConstants" />
    </MakeVersionDefines>
  </Target>

  <ItemGroup>
    <ProjectReference Include="../Source/SharpGameInput.v$(GameInputApiVersion).csproj" />
    <Using Include="SharpGameInput.v$(GameInputApiVersion)" />

    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.205">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Condition="'$(TargetFramework)' == 'net48'" Include="System.Memory" Version="4.5.5" />
    <PackageReference Condition="'$(TargetFramework)' == 'net48'" Include="Shim.System.Text.Rune" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)/**/*.cs" LinkBase="Common" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)/NativeMethods.txt" LinkBase="Common" />
  </ItemGroup>

</Project>